# =====================================================================
# SparePartsIQ – Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and fill in your environment-specific values.
# NEVER commit the actual '.env' file containing real secrets to GitHub!
# =====================================================================

# Application Storage Mode: 'local' (SQLite database) or 'aws' (DynamoDB & S3)
STORAGE_MODE=local

# AWS Region (Required if STORAGE_MODE=aws)
AWS_REGION=ap-south-1

# AWS Named Profile or leave blank to use default AWS CLI / IAM Role credentials
# AWS_PROFILE=default

# AWS S3 Bucket Name for Machine Learning model artifacts and datasets
# S3_BUCKET=your-sparepartsiq-artifacts-bucket

# Amazon SNS Topic ARN for operational stockout and maintenance alerts
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:SparePartsIQ-Alerts

# Mandatory Cryptographic JWT Signing Key (256-bit secure hex string)
# Generate a new random secret using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_256_bit_random_hex_key_here

# Optional: Seed User Default Password for initial database population
# SEED_USER_PASSWORD=ChangeMe@2026

# Optional: Additional CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
